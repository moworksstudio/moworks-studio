{
  "_about": "Pinned runtime for Moworks Studio. HyperFrames is installed per version under runtime/hf/<version>/ by the version manager (never as a dependency of this repo). current / previous are kept in runtime/hf/state.json.",
  "hyperframes": {
    "default": "0.8.214",
    "packages": [
      "@hyperframes/producer",
      "@hyperframes/player",
      "@hyperframes/sdk",
      "hyperframes"
    ],
    "versions": {
      "0.8.214": {
        "chromium": "152.0.7977.30"
      },
      "0.8.163": {
        "chromium": "152.0.7977.30"
      }
    },
    "repo": "heygen-com/hyperframes",
    "registryRoot": "{app}/bundle/hf/registry",
    "skillsRoot": "{app}/bundle/hf/skills",
    "source": { "url": "https://github.com/heygen-com/hyperframes.git", "commit": "4719543e972548a261b8354f0a8dada479ae5d93", "_about": "the commit the skills and registry are pinned to (v0.8.214); a new computer fetches only skills/ and registry/ at it into runtime/hf-src (packages/setup/hf-skills.mjs)" },
    "_sourceAbout": "registryRoot / skillsRoot: the read-only HF clone at the pinned release (v0.8.214, 4719543); never edited from here. Update path: fetch the clone and check out the new tag; npm run hf -- install <v> (versions entry first), then switch (smoke test); set default and source.commit; node tools/make-bundle.mjs --only hf-skills,hf-registry; re-import the Blocks and Looks stores; node tools/intake-motion-prompt.mjs (the Vocabulary cites HF's registry); node tools/make-bundle.mjs --only library-blocks,library-looks,library-vocab; a golden run and the full suite"
  },
  "chromium": {
    "152.0.7977.30": {
      "path": "%USERPROFILE%/.cache/hyperframes/chrome/chrome-headless-shell/win64-152.0.7977.30/chrome-headless-shell-win64/chrome-headless-shell.exe"
    }
  },
  "ffmpeg": {
    "version": "9.0",
    "dir": "%LOCALAPPDATA%/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-9.0-full_build/bin"
  },
  "env": {
    "HYPERFRAMES_NO_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "HYPERFRAMES_NO_UPDATE_CHECK": "1",
    "HYPERFRAMES_NO_AUTO_INSTALL": "1",
    "HYPERFRAMES_SKIP_SKILLS": "1",
    "PUPPETEER_SKIP_DOWNLOAD": "1"
  },
  "fonts": {
    "_about": "Bundled fonts (HF's embedded fonts are latin-only): the files listed in config/fonts.json, downloaded once from google/fonts at the pinned commit into this folder (packages/offline-assets)",
    "dir": "runtime/fonts/bundled"
  },
  "gsap": {
    "_about": "GSAP copied into every project (assets/vendor) so films play offline; the same file as the Moworks Motion kit's 3.15.0 (SHA-256 checked 17/10/2026)",
