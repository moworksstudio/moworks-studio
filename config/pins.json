    "url": "https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js",
    "sha256": "92bb9a96476f983d212a2bc4f54c889039c1696dd4461d40a736860938570fbb",
    "licence": "GSAP Standard no-charge license, https://gsap.com/standard-license",
    "file": "runtime/vendor/gsap/3.15.0/gsap.min.js",
    "motionPath": {
      "_about": "MotionPathPlugin at the same version, copied next to gsap.min.js: HyperFrames Studio loads it from jsDelivr unless the film already has it, and the film's offline CSP blocks the CDN (SHA-256 checked 17/10/2026)",
      "url": "https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/MotionPathPlugin.min.js",
      "sha256": "ace44a07c6c179f5347d9b46a152d468e4c9f272ee0d68bf0354e00d60000693",
