{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "animated-circular-progress-bar",
  "type": "hyperframes:block",
  "title": "Animated Circular Progress Bar",
  "description": "A circular gauge: a coloured arc for the value and a grey arc for the rest with small gaps, the percentage in the middle, sliding when the value changes.",
  "tags": [
    "progress",
    "gauge",
    "ring",
    "percent",
    "chart",
    "stat",
    "magicui"
  ],
  "files": [
