      "target": "compositions/components/animated-circular-progress-bar.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [],
  "duration": 6,
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "moworks": {
    "uid": "in:magicui/animated-circular-progress-bar",
    "author": "magicui",
    "call": "MW.animatedCircularProgressBar(q(\".mw-animated-circular-progress-bar\"), tl, 0, { values: [[0, 0], [0.5, 30], [2, 64], [3.5, 92]], gaugePrimaryColor: \"#a78bfa\" });",
    "function": "MW.animatedCircularProgressBar",
    "options": {
      "min": "0",
      "max": "100",
      "values": "[[0, 0], [0.5, 72]]",
      "gaugePrimaryColor": "#a78bfa",
      "gaugeSecondaryColor": "rgba(255,255,255,0.1)",
      "countNumber": "false"
    },
    "credit": {
      "author": "Magic UI (magicuidesign)",
