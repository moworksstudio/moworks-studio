{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "noise-texture",
  "type": "hyperframes:component",
  "title": "Noise Texture",
  "description": "A subtle grey fractal-noise overlay for a grainy surface; static as upstream, or re-seeded at a set rate for moving grain.",
  "tags": [
    "noise",
    "grain",
    "texture",
    "overlay",
    "film",
    "magicui"
  ],
  "files": [
    {
      "path": "noise-texture.html",
      "target": "compositions/components/noise-texture.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [],
  "duration": 5,
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "moworks": {
    "uid": "in:magicui/noise-texture",
    "author": "magicui",
    "call": "MW.noiseTexture(q(\".mw-noise-texture\"), tl, 0, { slope: 0.6, noiseOpacity: 0.9, animate: true, hold: 5 });",
    "function": "MW.noiseTexture",
    "options": {
      "frequency": "0.4",
      "octaves": "6",
      "slope": "0.15",
      "noiseOpacity": "0.6",
      "layerOpacity": "0.75 (dark), 0.5 (light)",
      "animate": "false",
      "fps": "12",
      "hold": "seconds when animated (10)"
    },
    "credit": {
