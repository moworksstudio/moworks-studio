      "path": "ripple-button.html",
      "target": "compositions/components/ripple-button.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [],
  "duration": 5,
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "moworks": {
    "uid": "in:magicui/ripple-button",
    "author": "magicui",
    "call": "MW.rippleButton(q(\".mw-ripple-button\"), tl, 0.5, { rippleColor: \"#ADD8E6\", duration: 0.6, clicks: [[0, 120, 60], [1.2, 420, 80], [2.4, 260, 50]] });",
    "function": "MW.rippleButton",
    "options": {
      "rippleColor": "#ffffff",
      "duration": "s (0.6)",
      "clicks": "[[0, x, y], ...]"
    },
    "credit": {
