      "read": "2026-10-12",
      "licence": "MIT",
      "notice": "MIT License, Copyright (c) Magic UI (LICENSE.md)",
      "made": "adapted",
      "madeNote": "ported to GSAP on the film's clock; same timings, eases, sizes and colours; the original is linked",
      "sourceText": "magicuidesign/magicui at efe76fc, apps/www/registry/magicui/ripple-button.tsx",
      "upstream": null
    },
    "thirdParty": [],
    "notes": "clicks: [[t, x, y], ...] in s after `at` and px inside the button (default: its centre at 0 s).",
