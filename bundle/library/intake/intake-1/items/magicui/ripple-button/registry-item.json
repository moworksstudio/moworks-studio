  "name": "ripple-button",
  "type": "hyperframes:component",
  "title": "Ripple Button",
  "description": "A circular ink ripple spreads from the press point inside a button and fades (0.6 s), for each tap of a scripted cursor or finger.",
  "tags": [
    "button",
    "ripple",
    "tap",
    "press",
    "click",
    "material",
    "magicui"
  ],
  "files": [
