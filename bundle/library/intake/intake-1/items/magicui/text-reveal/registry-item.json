    "width": 1920,
    "height": 1080
  },
  "moworks": {
    "uid": "in:magicui/text-reveal",
    "author": "magicui",
    "call": "MW.textReveal(q(\".mw-text-reveal\"), tl, 0.5, { duration: 4.5, ghost: 0.2 });",
