{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "grid-pattern",
  "type": "hyperframes:component",
  "title": "Grid Pattern",
  "description": "A fine line grid with a few filled cells, usually skewed and faded at the edges with a radial mask: a calm SaaS backdrop (static, or drifting slowly).",
  "tags": [
    "grid",
    "pattern",
    "background",
    "lines",
    "tech",
    "magicui"
  ],
  "files": [
