      "path": "grid-pattern.html",
      "target": "compositions/components/grid-pattern.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [],
  "duration": 6,
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "moworks": {
    "uid": "in:magicui/grid-pattern",
    "author": "magicui",
    "call": "MW.gridPattern(q(\".mw-grid-pattern\"), tl, 0, { width: 80, height: 80, color: \"rgba(156,163,175,0.35)\", squares: [[4,4],[5,1],[8,2],[5,3],[5,5],[10,10],[12,15],[15,10],[10,15],[15,10],[10,15],[15,10]], drift: [0, 20], hold: 6 });",
    "function": "MW.gridPattern",
    "options": {
      "width": "cell px (40)",
      "height": "cell px (40)",
      "x": "-1",
      "y": "-1",
      "strokeDasharray": "'0'",
      "squares": "[[col, row], ...] filled cells",
      "color": "rgba(156,163,175,0.3)",
      "drift": "[x, y] px/s ([0, 0])",
      "hold": "seconds the drift runs (10)"
    },
    "credit": {
      "author": "Magic UI (magicuidesign)",
      "collection": "Magic UI",
